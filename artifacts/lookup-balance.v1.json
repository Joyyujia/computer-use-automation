{
  "schemaVersion": "1.0",
  "id": "member.lookup-savings-balance",
  "version": "1.0.0",
  "name": "Look up savings balance",
  "description": "Find a member and return the displayed savings balance.",
  "surface": { "adapter": "playwright", "appFamily": "northstar-core", "entrypoint": "http://127.0.0.1:4173/" },
  "inputs": { "memberId": { "type": "string", "description": "Institution-scoped member identifier", "sensitive": true } },
  "outputs": { "balance": { "type": "string", "description": "Display-formatted savings balance", "sensitive": true } },
  "steps": [
    { "id": "open", "action": "navigate", "value": { "source": "literal", "value": "http://127.0.0.1:4173/" }, "risk": "safe", "timeoutMs": 5000, "retries": 1 },
    { "id": "enter-member", "action": "fill", "target": { "strategy": "label", "value": "Member Number", "logicalTarget": "member-number-input", "fallback": [{ "strategy": "css", "value": "input[name=memberNumber]", "logicalTarget": "member-number-input", "fallback": [], "rationale": "Legacy name attribute fallback for the reviewed member-number control" }], "rationale": "Accessible label is stable across layout changes" }, "value": { "source": "input", "key": "memberId" }, "risk": "safe", "timeoutMs": 5000, "retries": 1 },
    { "id": "submit", "action": "click", "target": { "strategy": "role", "value": "button", "name": "Find Member", "fallback": [], "rationale": "Role and visible name express user intent" }, "risk": "safe", "timeoutMs": 5000, "retries": 1 },
    { "id": "read-balance", "action": "extract", "target": { "strategy": "css", "value": "#balance", "fallback": [], "rationale": "Scoped balance field independent of its runtime value" }, "outputKey": "balance", "risk": "safe", "timeoutMs": 5000, "retries": 0 }
  ],
  "checkpoint": { "kind": "text", "locator": { "strategy": "css", "value": "#detail-member-id", "fallback": [], "rationale": "Displayed record identifier must equal the invocation input" }, "expected": { "source": "input", "key": "memberId" }, "timeoutMs": 5000 },
  "successAssertions": [
    { "kind": "visible", "locator": { "strategy": "css", "value": "#detail", "fallback": [], "rationale": "Member detail container" }, "timeoutMs": 5000 }
  ],
  "businessOutcomes": [
    { "code": "member_not_found", "message": "No member exists for the supplied identifier", "assertion": { "kind": "text", "locator": { "strategy": "css", "value": "#message", "fallback": [], "rationale": "Dedicated application alert region" }, "expected": { "source": "literal", "value": "Member not found" }, "timeoutMs": 5000 } }
  ],
  "recoveries": [
    { "id": "dismiss-service-notice", "when": { "kind": "visible", "locator": { "strategy": "css", "value": "#service-notice", "fallback": [], "rationale": "Known service notice" }, "timeoutMs": 1000 }, "steps": [{ "id": "dismiss-service-notice", "action": "click", "target": { "strategy": "css", "value": "#dismiss-notice", "fallback": [], "rationale": "Dismiss control inside known notice" }, "risk": "safe", "timeoutMs": 1000, "retries": 0 }], "maxAttempts": 1 }
  ],
  "interventions": [
    { "code": "session_expired", "message": "The application session expired", "assertion": { "kind": "visible", "locator": { "strategy": "css", "value": "#session-expired", "fallback": [], "rationale": "Session expiry alert" }, "timeoutMs": 1000 }, "resume": "retry_step" }
  ],
  "approval": "draft",
  "createdAt": "2026-09-12T00:00:00.000Z"
}
