    { "id": "read-balance", "action": "extract", "target": { "strategy": "text", "value": "$2,418.73", "fallback": [{ "strategy": "css", "value": "#balance", "fallback": [], "rationale": "Scoped legacy identifier" }], "rationale": "Recorded visible value with structural fallback" }, "outputKey": "balance", "risk": "safe", "timeoutMs": 5000, "retries": 1 }
